# Copiar este archivo como .env y ajustar si hace falta.
# La aplicación y docker compose leen las mismas variables.

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=logistica
PG_USER=tp
PG_PASSWORD=tp_clave

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logistica_docs

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tp_clave_neo4j

# Cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=logistica_iot
CASSANDRA_DATACENTER=datacenter1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Aplicación
SESION_TTL_SEGUNDOS=1800
LOG_NIVEL=INFO
LOG_CARPETA=logs
